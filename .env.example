PORT=3006

# Storage defaults to the repository directory for local development and to
# /home/data in the production container. Any explicit path below wins.
# DATA_ROOT=./data
DB_PATH=./workshop.db
UPLOADS_PATH=./uploads
# USERS_DIR=./users
# SEED_DB_PATH=./workshop-seed.db

# Recovery bundles contain WAL-safe SQLite snapshots plus every uploaded file.
# Production defaults: /home/data/backups, first run after 5 minutes, every
# 24 hours, and seven complete bundles retained. Set the interval to 0 to
# disable the in-process scheduler.
# BACKUP_PATH=./backups
# BACKUP_INTERVAL_HOURS=24
# BACKUP_INITIAL_DELAY_MINUTES=5
# BACKUP_RETENTION_COUNT=7
# BACKUP_QUIESCE_TIMEOUT_MS=30000
# BACKUP_LOCK_STALE_MINUTES=360

# Managed-identity off-host export is production-only and explicitly disabled
# until the private network, least-privilege RBAC, and manual read-back drill pass.
OFFHOST_BACKUP_ENABLED=false
OFFHOST_BACKUP_ACCOUNT=<recovery-storage-account>
OFFHOST_BACKUP_CONTAINER=workshop
OFFHOST_BACKUP_SCAN_INTERVAL_MINUTES=60
OFFHOST_BACKUP_STALE_HOURS=26
OFFHOST_BACKUP_HEALTH_LOOKBACK_HOURS=2
OFFHOST_BACKUP_DAILY_HEALTH_MAX_SOURCE_AGE_HOURS=23
OFFHOST_BACKUP_MONTHLY_STALE_DAYS=35
OFFHOST_BACKUP_CLOCK_SKEW_MINUTES=5

# Optional — enables the "Analyze with AI" button on the project form.
# If unset, the rest of the app still works.
ANTHROPIC_API_KEY=

# ── Auth (required) ───────────────────────────────────────────────────────────
# The backend validates every API request against Microsoft Entra ID.
# The frontend (MSAL) uses the VITE_ prefixed copies at build time.
# Server refuses to start without AZURE_HOME_TENANT_ID and API_AUDIENCE set.
#
# How to find these values:
#   Azure Portal → Microsoft Entra ID → App registrations → your app
#   AZURE_HOME_TENANT_ID = legacy/home Directory (tenant) ID
#   API_AUDIENCE         = Application (client) ID

AZURE_HOME_TENANT_ID=<your-home-tenant-id>
API_AUDIENCE=<your-app-client-id>

# Frontend (Vite build-time). Keep AUTHORITY_TENANT_ID set to the home tenant
# until the app registration audience is multitenant, then change it to `common`.
VITE_AZURE_AUTHORITY_TENANT_ID=<your-home-tenant-id>
VITE_AZURE_HOME_TENANT_ID=<your-home-tenant-id>
VITE_AZURE_CLIENT_ID=<your-app-client-id>

# Optional legacy-migration key only. This no longer restricts access. Set it to
# the home-tenant user's oid only when an existing DB_PATH must become that
# user's per-account database.
ALLOWED_OID=

# ── Sign in with Apple (native iOS) ───────────────────────────────────────────
# Current iOS clients send a one-time authorization code to POST /api/auth/apple.
# The server exchanges it with Apple, encrypts the returned refresh token, and
# revokes that token before deleting an Apple-backed account. Legacy clients
# without the code can still sign in, but must reauthenticate before deletion.
#
# APPLE_PRIVATE_KEY is the .p8 Sign in with Apple key in PEM form. App Service
# may store it with literal \n sequences; the server expands them at startup.
# Keep SESSION_SECRET, APPLE_PRIVATE_KEY, and APPLE_TOKEN_ENCRYPTION_KEY in Key
# Vault. APPLE_TOKEN_ENCRYPTION_KEY must be at least 32 characters and stable:
# changing it makes already-stored Apple refresh tokens unreadable.
SESSION_SECRET=
APPLE_BUNDLE_ID=com.nintek.workshop
APPLE_WEB_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_TOKEN_ENCRYPTION_KEY=

# Optional — URL for a companion app shown on the dashboard.
# Leave blank to hide the link entirely.
VITE_SHOPKEEP_URL=

# Tabloom integration (read-only). The Workshop notebook UI pulls its pages
# from a notebook named "Workshop" in the sibling Tabloom app.
#   - VITE_TABLOOM_API_BASE_URL: origin of the Tabloom server
#   - VITE_TABLOOM_CLIENT_ID:    Tabloom's AAD app client ID (used to mint a
#                                token with audience `api://<id>/access_as_user`)
# Workshop's AAD app must be granted delegated `access_as_user` on Tabloom's
# API for this to work — see Tabloom's CLAUDE.md.
VITE_TABLOOM_API_BASE_URL=https://app-tabloom-prod-lwxhu7jxlrbtu.azurewebsites.net
VITE_TABLOOM_CLIENT_ID=b30f09b9-e100-4aa5-af22-ce359ff13fba
