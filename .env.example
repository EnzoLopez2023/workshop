PORT=3006
DB_PATH=./workshop.db

# Optional — enables the "Analyze with AI" button on the project form.
# If unset, the rest of the app still works.
ANTHROPIC_API_KEY=

# ── Auth (required) ───────────────────────────────────────────────────────────
# The backend validates every API request against Azure AD.
# The frontend (MSAL) uses the VITE_ prefixed copies at build time.
# Server refuses to start without AZURE_TENANT_ID and API_AUDIENCE set.
#
# How to find these values:
#   Azure Portal → Azure Active Directory → App registrations → your app
#   AZURE_TENANT_ID  = Directory (tenant) ID
#   API_AUDIENCE     = Application (client) ID
#   VITE_ copies must match the values above.

AZURE_TENANT_ID=<your-tenant-id>
API_AUDIENCE=<your-app-client-id>

# Frontend (Vite build-time) — must match the values above
VITE_AZURE_TENANT_ID=<your-tenant-id>
VITE_AZURE_CLIENT_ID=<your-app-client-id>

# Optional — lock the API to a single user's object id (`oid` claim).
# Leave blank to allow any signed-in tenant user. Decode an access token at
# https://jwt.ms to find your oid, then set it here.
ALLOWED_OID=

# Optional — URL for a companion app shown on the dashboard.
# Leave blank to hide the link entirely.
VITE_SHOPKEEP_URL=
